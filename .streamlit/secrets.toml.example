# Copy this file to secrets.toml (same folder) and fill in your key.
# secrets.toml is for local/dev only — do not commit it.
#
# Alternative: create a file named .env in the project folder (next to UI.py) with:
#   GEMINI_API_KEY=your_key_here
#   GEMINI_MODEL=gemini-2.0-flash
#
# On Windows you can also set GEMINI_API_KEY in System Environment Variables.

GEMINI_API_KEY = "paste-your-key-here"
